# Required for the chat widget to use a real LLM. Without it, the widget still
# works — it falls back to returning the best-matching knowledge-base chunk directly.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the default Groq model (llama-3.1-8b-instant)
GROQ_MODEL=

# Optional: an extra allowed origin for the chat API (e.g. a custom domain).
# Same-origin requests to your Vercel URL are allowed automatically without this.
SITE_URL=
